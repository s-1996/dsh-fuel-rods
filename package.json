{
  "name": "@local/dsh-fuel-rods",
  "version": "2.4.2",
  "private": true,
  "type": "module",
  "description": "WebGL2 Bloom reactor over a reference-style stage gradient, with optional sidebar sync, conversation-sized rods, four background tones, rod sensitivity, motion smoothing, and an estimated session cost footer.",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
